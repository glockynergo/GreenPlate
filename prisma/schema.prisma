generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      String
  demo      Boolean    @default(false)
  shop      Shop?
  sessions  Session[]
  orders    Order[]
  favorites Favorite[]
}
model Session {
  tokenHash String   @id
  expires   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expires])
}
model Shop {
  id          String  @id @default(uuid())
  ownerId     String  @unique
  owner       User    @relation(fields: [ownerId], references: [id])
  name        String
  kind        String
  address     String
  city        String
  description String
  demo        Boolean @default(false)
  offers      Offer[]
  orders      Order[]
}
model Offer {
  id          String     @id @default(uuid())
  shopId      String
  shop        Shop       @relation(fields: [shopId], references: [id])
  title       String
  description String
  category    String
  image       String
  original    Int
  price       Int
  stock       Int
  ingredients String
  allergens   String
  storage     String
  starts      DateTime
  ends        DateTime
  active      Boolean    @default(true)
  donation    Boolean    @default(false)
  updated     DateTime   @updatedAt
  orders      Order[]
  favorites   Favorite[]
  @@index([active, donation, ends])
  @@index([shopId])
}
model Order {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id])
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  quantity  Int
  unit      Int
  original  Int
  total     Int
  fee       Int
  payout    Int
  status    String   @default("confirmed")
  code      String   @unique
  snapshot  Json
  starts    DateTime
  ends      DateTime
  created   DateTime @default(now())
  @@index([userId, created])
  @@index([shopId, status, ends])
}
model Favorite {
  userId  String
  offerId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  @@id([userId, offerId])
}
